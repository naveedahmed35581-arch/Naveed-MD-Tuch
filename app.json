{
  "name": "QUEEN-MD",
  "description": "Queen MD WhatsApp Bot (multi user, MongoDB session)",
  "keywords": ["whatsapp", "bot", "queen-md"],
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB connection string (mongodb+srv://...)",
      "required": true
    },
    "OWNER_NUMBER": {
      "description": "Owner number with country code, no + (e.g. 923001234567)",
      "required": false
    },
    "ADMIN_KEY": {
      "description": "Secret key for admin routes (/disconnect, /connect-all, /active)",
      "required": false
    }
  }
}
